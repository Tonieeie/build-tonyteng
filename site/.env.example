# Contact form (app/api/contact/route.ts) sends through Resend — https://resend.com
RESEND_API_KEY=
# Where new project requests are delivered
CONTACT_TO_EMAIL=
# Optional. Default "build.tonyteng.dev <onboarding@resend.dev>" only delivers to your own Resend
# account email. Verify tonyteng.dev in Resend, then use e.g. "Tony Teng <hello@tonyteng.dev>".
CONTACT_FROM_EMAIL=
